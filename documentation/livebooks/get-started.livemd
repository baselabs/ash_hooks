# AshHooks — a guided tour

<!-- livebook:{"app_settings":{"access_type":"public","auto_run":true,"show_source":true,"locale":"en"}} -->

## You will learn

* Receive an inbound webhook: verify its signature, deduplicate a replay, reject a tamper
* Send an outbound webhook to an existing WebHook Tester inbox and verify its captured bytes
* Scope a multi-tenant deployment: one tenant's dispatch never reaches another's rows
* Fit the extensions to a domain that reserves `payload`, owns an `active` switch, and types its registers with atoms
* Observe everything through telemetry
* Prune old rows with the retention hooks

This notebook uses a real SQLite database and an existing WebHook Tester
receiver. The receiver must already answer at `http://127.0.0.1:52871`;
set `LOCAL_WEBHOOK_TESTER_PORT` to use another existing receiver. See
the [local receiver guide](https://github.com/baselabs/ash_hooks/blob/main/ops/local/README.md).
The notebook starts no server.
Uses ash_hooks **2.0.0**. Its examples exercise the library locally; vendor-origin
delivery and a production queue require your own application integration.

<!-- livebook:{"break_marks":true} -->

## Setup

```elixir
package =
  case System.get_env("ASH_HOOKS_NOTEBOOK_SOURCE") do
    nil -> {:ash_hooks, "== 2.0.0"}
    source -> {:ash_hooks, path: Path.expand(source)}
  end

# Release verification supplies the unpacked candidate archive explicitly.
# Normal notebook execution resolves the exact published version above.
Mix.install([
  {:ash, ">= 3.34.3 and < 4.0.0-0"},
  package,
  {:ash_sqlite, "~> 0.2"},
  {:jason, "~> 1.2"}
])
```

```elixir
# Ash 3.33+ requires every application to choose how string length is
# counted before any resource compiles — this notebook is its own app.
# :codepoints is Ash's recommended value: max_length bounds value size
# and matches how SQL data layers count.
Application.put_env(:ash, :default_string_length_count, :codepoints)
Application.put_env(:ash_hooks, :tour_inbound_secret, :crypto.strong_rand_bytes(32))
"2.0.0" = Application.spec(:ash_hooks, :vsn) |> to_string()
```

```elixir
defmodule Tour.Repo do
  use AshSqlite.Repo, otp_app: :ash_hooks
end
```

```elixir
defmodule Tour.VerifiedEvent do
  defstruct [:type, :payload]
end

# A minimal inbound provider — your integration point for any vendor.
# The scheme here is the common one: lowercase-hex HMAC-SHA256 over the
# raw body, so verify delegates to the package's default.
defmodule Tour.Provider do
  @behaviour AshHooks.Provider

  @impl true
  def verify_signature(raw_body, %{signature: signature}, secret),
    do: AshHooks.Provider.default_verify_signature(raw_body, signature, secret, :hmac_sha256)

  # Map the vendor's type strings to your event atoms — an explicit
  # table, never String.to_atom on provider input (that would let a
  # hostile sender grow your atom table). Unknown types fail closed.
  @impl true
  def parse_event_type(%{"type" => "order.paid"}), do: {:ok, :order_paid}

  def parse_event_type(_), do: {:error, :unknown_event_type}

  @impl true
  def handle_event(type, payload), do: {:ok, %Tour.VerifiedEvent{type: type, payload: payload}}
end

defmodule Tour.Ledger do
  use Ash.Resource,
    domain: Tour.Domain,
    data_layer: AshSqlite.DataLayer,
    extensions: [AshHooks, AshHooks.InboundDelivery]

  sqlite do
    table("tour_ledgers")
    repo(Tour.Repo)
  end

  inbound_delivery do
    scope_identity([:account_id])
  end

  attributes do
    attribute(:account_id, :string, allow_nil?: false)
    timestamps()
  end

  actions do
    defaults([:read])
  end

  webhooks do
    inbound :tour do
      provider(Tour.Provider)
      # a secret source — never a literal
      secret fn -> {:ok, Application.fetch_env!(:ash_hooks, :tour_inbound_secret)} end
      event_id(&__MODULE__.event_id/1)
    end
  end

  def event_id(%{"id" => id}), do: {:ok, id}
  def event_id(_), do: :error
end

defmodule Tour.Endpoint do
  use Ash.Resource,
    domain: Tour.Domain,
    data_layer: AshSqlite.DataLayer,
    extensions: [AshHooks.Endpoint]

  sqlite do
    table("tour_endpoints")
    repo(Tour.Repo)
  end

  actions do
    defaults([:read, :create, :update])
    default_accept(:*)
  end
end

defmodule Tour.Subscription do
  use Ash.Resource,
    domain: Tour.Domain,
    data_layer: AshSqlite.DataLayer,
    extensions: [AshHooks.Subscription]

  sqlite do
    table("tour_subscriptions")
    repo(Tour.Repo)
  end

  actions do
    defaults([:read, :create])
    default_accept(:*)
  end

  subscription do
    endpoint_resource(Tour.Endpoint)
  end
end

defmodule Tour.Delivery do
  use Ash.Resource,
    domain: Tour.Domain,
    data_layer: AshSqlite.DataLayer,
    extensions: [AshHooks.OutboundDelivery]

  sqlite do
    table("tour_deliveries")
    repo(Tour.Repo)
  end

  attributes do
    timestamps()
  end

  actions do
    defaults([:read])
  end
end

defmodule Tour.Order do
  use Ash.Resource,
    domain: Tour.Domain,
    data_layer: AshSqlite.DataLayer,
    extensions: [AshHooks]

  sqlite do
    table("tour_orders")
    repo(Tour.Repo)
  end

  attributes do
    uuid_primary_key(:id)
  end

  actions do
    defaults([:read, :create])
  end

  webhooks do
    outbound :order_paid do
      subscriptions(Tour.Subscription)
      deliveries(Tour.Delivery)
    end
  end
end

defmodule Tour.Domain do
  use Ash.Domain, otp_app: nil, validate_config_inclusion?: false

  resources do
    resource(Tour.Ledger)
    resource(Tour.Endpoint)
    resource(Tour.Subscription)
    resource(Tour.Delivery)
    resource(Tour.Order)
    resource(Tour.TenantEndpoint)
    resource(Tour.TenantSubscription)
    resource(Tour.TenantDelivery)
    resource(Tour.TenantOrder)
  end
end
```

